# Copy to .env next to docker-compose.yml. Placeholders only; .env is gitignored.
# demo (default): saved examples only, no key, no network.
CLIMATE_SUITE_MODE=demo
# Live mode needs your own key (and the models and index built; see the README).
GEMINI_API_KEY=
# Optional: address of the small language model service on the host.
SLM_URL=
# Optional passage check by the small language model: off by default, effect not measured.
CLIMATE_SUITE_SLM=off
