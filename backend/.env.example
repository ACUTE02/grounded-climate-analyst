# Copy this file to backend/.env and put your own key in it. backend/.env is
# gitignored; this example file contains only placeholders.

# Needed only for live mode (CLIMATE_SUITE_MODE=live) and for building the retrieval
# index. Demo mode does not use it. A free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: data.gov.in key for the live crop-statistics source.
# DATA_GOV_IN_API_KEY=your-data-gov-in-key-here

# Optional passage check by the small language model: off by default; its effect on the reports is not measured.
# CLIMATE_SUITE_SLM=off
# SLM_URL=http://127.0.0.1:8001

# demo (default): answers only the saved examples in backend/demo/, no network, no key.
# live: runs the real pipeline; needs the key above, the models (python -m scripts.setup)
# and the retrieval index (python -m retrieval.build).
CLIMATE_SUITE_MODE=demo
